{
  "name": "@samvaad/db",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "DOTENV_CONFIG_PATH=../../.env drizzle-kit generate",
    "db:migrate": "DOTENV_CONFIG_PATH=../../.env vpx src/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
