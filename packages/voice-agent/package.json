{
  "name": "@samvaad/voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "vp run --filter @samvaad/voice-protocol build",
    "dev": "DOTENV_CONFIG_PATH=../../.env vpx src/index.ts dev --log-level=debug",
    "start": "DOTENV_CONFIG_PATH=../../.env node dist/voice-agent/src/index.js start",
    "prebuild": "vp run --filter @samvaad/voice-protocol build",
    "build": "tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@livekit/agents": "^1.10.0",
    "@livekit/agents-plugin-deepgram": "^1.10.0",
    "@livekit/agents-plugin-openai": "^1.10.0",
    "@livekit/agents-plugin-silero": "^1.10.0",
    "@livekit/rtc-node": "^1.2.2",
    "@samvaad/voice-protocol": "workspace:*",
    "dotenv": "^18.0.10",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
