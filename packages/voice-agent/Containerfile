FROM node:22-bookworm-slim AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@12.21.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/api/package.json packages/api/package.json
COPY packages/web/package.json packages/web/package.json
COPY packages/voice-agent/package.json packages/voice-agent/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/voice-protocol/package.json packages/voice-protocol/package.json
RUN pnpm install --filter @samvaad/voice-agent... --frozen-lockfile

COPY packages/voice-agent ./packages/voice-agent
COPY packages/voice-protocol ./packages/voice-protocol
RUN pnpm --filter @samvaad/voice-protocol build \
	&& pnpm --filter @samvaad/voice-agent build \
	&& pnpm --filter @samvaad/voice-agent deploy --prod /prod/voice-agent

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=build /prod/voice-agent ./

CMD ["node", "dist/voice-agent/src/index.js", "start"]
