# Copy this file to .env at the repository root.
# All workspace packages load configuration from that one file.
API_PORT=18765
API_HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/samvaad
DB_POOL_MAX=10

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# In development, Google OAuth returns through the web server's API proxy.
BETTER_AUTH_URL=http://localhost:5177
FRONTEND_URL=http://localhost:5177
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional for sibling production subdomains, e.g. app.example.com/api.example.com:
# AUTH_COOKIE_DOMAIN=.example.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GROQ_API_KEY=your-groq-api-key
# Groq model IDs; override these to evaluate alternatives.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_MEMORY_MODEL=openai/gpt-oss-20b
HISTORY_WINDOW_SIZE=6
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_EMBEDDING_MODEL=voyage-4-large
VOYAGE_RERANK_MODEL=rerank-3
LLAMA_CLOUD_API_KEY=your-llamacloud-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
VOICE_AGENT_SHARED_SECRET=replace-with-a-long-random-secret

LIVEKIT_URL=ws://localhost:17880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=samvaad-voice

# Used by production builds; Vite development uses its same-origin API proxy.
VITE_API_URL=http://localhost:18765

SAMVAAD_API_URL=http://127.0.0.1:18765
DEEPGRAM_STT_MODEL=nova-3-general
DEEPGRAM_STT_BASE_URL=wss://api.deepgram.com
DEEPGRAM_TTS_BASE_URL=https://api.deepgram.com
